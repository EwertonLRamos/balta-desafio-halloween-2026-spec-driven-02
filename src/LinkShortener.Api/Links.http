@baseUrl = http://localhost:5000

### Create a link
POST {{baseUrl}}/api/links
Content-Type: application/json

{
  "targetUrl": "https://example.com/destination"
}

### Create a link with a custom code
POST {{baseUrl}}/api/links
Content-Type: application/json

{
  "targetUrl": "https://example.com/destination",
  "code": "MY42"
}

### Redirect to a link destination
GET {{baseUrl}}/MY42

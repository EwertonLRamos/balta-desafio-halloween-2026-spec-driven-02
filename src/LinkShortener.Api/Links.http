@baseUrl = http://localhost:5000
@managementKey = paste-management-key-from-create-response

### Create a link
POST {{baseUrl}}/api/links
Content-Type: application/json

{
  "targetUrl": "https://example.com/destination"
}

### Create a link with a custom code
POST {{baseUrl}}/api/links
Content-Type: application/json

{
  "targetUrl": "https://example.com/destination",
  "code": "MY42"
}

### Redirect to a link destination
GET {{baseUrl}}/MY42

### Get link statistics (replace the value with the managementKey returned on creation)
GET {{baseUrl}}/api/links/MY42/stats
X-Management-Key: {{managementKey}}
